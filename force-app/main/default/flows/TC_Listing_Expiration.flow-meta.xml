<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <decisions>
        <name>Flows_Bypassed</name>
        <label>Flows Bypassed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Listing_Timing</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Run</defaultConnectorLabel>
        <rules>
            <name>Bypassed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Bypass_Flows</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Bypassed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Listing_Timing</name>
        <label>Listing Timing</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Nothing due</defaultConnectorLabel>
        <rules>
            <name>Already_Expired</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.TC_Expiration_Date__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Expired</targetReference>
            </connector>
            <label>Already expired</label>
        </rules>
        <rules>
            <name>Expires_In_30_Days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.TC_Expiration_Date__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>In_30_Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Task_Renew_Listing</targetReference>
            </connector>
            <label>Expires in 30 days</label>
        </rules>
    </decisions>
    <description>Daily for active listings: a task 30 days before the listing agreement expires, and status Expired once the expiration date has passed.</description>
    <environments>Default</environments>
    <formulas>
        <name>Bypass_Flows</name>
        <dataType>Boolean</dataType>
        <expression>{!$Setup.TC_Bypass_Settings__c.TC_Bypass_Flows__c}</expression>
    </formulas>
    <formulas>
        <name>Due_In_7_Days</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 7</expression>
    </formulas>
    <formulas>
        <name>In_30_Days</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 30</expression>
    </formulas>
    <formulas>
        <name>Task_Subject</name>
        <dataType>String</dataType>
        <expression>&quot;Listing agreement expires in 30 days: &quot; &amp; {!$Record.Name} &amp; &quot;. Discuss renewal with the owner.&quot;</expression>
    </formulas>
    <interviewLabel>TC Listing Expiration {!$Flow.CurrentDateTime}</interviewLabel>
    <label>TC Listing Expiration</label>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Task_Renew_Listing</name>
        <label>Task: Renew Listing</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>Due_In_7_Days</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>Task_Subject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Mark_Expired</name>
        <label>Mark Expired</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>TC_Status__c</field>
            <value>
                <stringValue>Expired</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Flows_Bypassed</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>TC_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <filters>
            <field>TC_Expiration_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>TC_Listing__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-11-13</startDate>
            <startTime>06:15:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
