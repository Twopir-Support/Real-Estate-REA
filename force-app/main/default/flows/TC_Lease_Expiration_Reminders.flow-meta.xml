    <description>Daily: creates a task for the lease owner 18, 12 and 6 months before the lease expires (the thresholds AscendixRE documents), and emails the owner at 6 months. Edit the Date formulas to change the thresholds.</description>
    <environments>Default</environments>
    <formulas>
        <name>Bypass_Flows</name>
        <dataType>Boolean</dataType>
        <expression>{!$Setup.TC_Bypass_Settings__c.TC_Bypass_Flows__c}</expression>
    </formulas>
    <formulas>
        <name>Date_12</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!$Flow.CurrentDate}, 12)</expression>
    </formulas>
    <formulas>
        <name>Date_18</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!$Flow.CurrentDate}, 18)</expression>
    </formulas>
    <formulas>
        <name>Date_6</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!$Flow.CurrentDate}, 6)</expression>
    </formulas>
    <formulas>
        <name>Due_In_7_Days</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 7</expression>
    </formulas>
    <formulas>
        <name>Email_Body_6</name>
        <dataType>String</dataType>
        <expression>&quot;The lease &quot; &amp; {!$Record.Name} &amp; &quot; expires on &quot; &amp; TEXT({!$Record.TC_Expiration_Date__c}) &amp; &quot;. A follow-up task has been created for you in TC Commercial Real Estate.&quot;</expression>
    </formulas>
    <formulas>
        <name>Subject_12</name>
        <dataType>String</dataType>
        <expression>&quot;Lease expires in 12 months: &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>Subject_18</name>
        <dataType>String</dataType>
        <expression>&quot;Lease expires in 18 months: &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>Subject_6</name>
        <dataType>String</dataType>
        <expression>&quot;Lease expires in 6 months: &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <interviewLabel>TC Lease Expiration Reminders {!$Flow.CurrentDateTime}</interviewLabel>
