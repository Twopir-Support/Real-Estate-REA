<apex:component >
<apex:attribute name="landscape" type="Boolean" default="false" description="Landscape page orientation"/>
<style>
@page { size: {!IF(landscape, 'letter landscape', 'letter')}; margin: 0.6in 0.6in 0.7in 0.6in;
  @bottom-center { content: "Page " counter(page) " of " counter(pages); font-size: 8pt; color: #6b7a83; } }
body { font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #15232b; }
.brand { border-bottom: 3px solid #0f5f74; padding-bottom: 6px; margin-bottom: 14px; }
.brand .co { font-size: 9pt; color: #0f5f74; text-transform: uppercase; letter-spacing: 1px; }
h1 { font-size: 20pt; margin: 2px 0 4px 0; }
h2 { font-size: 12pt; color: #0f5f74; border-bottom: 1px solid #d8e0e4; padding-bottom: 3px; margin: 16px 0 6px 0; }
.muted { color: #5a6b75; }
table.grid { width: 100%; border-collapse: collapse; font-size: 9pt; }
table.grid th { background: #e2f0f3; text-align: left; padding: 5px; border-bottom: 1px solid #b9cdd3; }
table.grid td { padding: 5px; border-bottom: 1px solid #e6ecef; }
table.facts td { padding: 3px 12px 3px 0; vertical-align: top; }
table.facts td.k { color: #5a6b75; width: 130px; }
.num { text-align: right; }
.hero { width: 100%; max-height: 260px; margin: 6px 0 8px 0; }
.stop { page-break-after: always; }
.foot { margin-top: 18px; font-size: 8pt; color: #6b7a83; }
</style>
</apex:component>
