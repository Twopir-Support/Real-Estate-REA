<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TC_Lost_Reason_Required</fullName>
    <active>true</active>
    <description>Choose a Lost Reason when closing a deal as Lost.</description>
    <errorConditionFormula>AND(
    NOT($Setup.TC_Bypass_Settings__c.TC_Bypass_Validation_Rules__c),
    AND(ISPICKVAL(TC_Status__c, &quot;Lost&quot;), ISBLANK(TEXT(TC_Lost_Reason__c)))
)</errorConditionFormula>
    <errorDisplayField>TC_Lost_Reason__c</errorDisplayField>
    <errorMessage>Choose a Lost Reason when closing a deal as Lost.</errorMessage>
</ValidationRule>
