<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TC_Contact_Info_Required</fullName>
    <active>true</active>
    <description>Enter the inquirer&apos;s Last Name or pick an existing Contact.</description>
    <errorConditionFormula>AND(
    NOT($Setup.TC_Bypass_Settings__c.TC_Bypass_Validation_Rules__c),
    AND(ISBLANK(TC_Contact__c), ISBLANK(TC_Last_Name__c))
)</errorConditionFormula>
    <errorDisplayField>TC_Last_Name__c</errorDisplayField>
    <errorMessage>Enter the inquirer&apos;s Last Name or pick an existing Contact.</errorMessage>
</ValidationRule>
