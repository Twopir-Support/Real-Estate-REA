<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TC_Days_Open__c</fullName>
    <formula>IF(OR(ISPICKVAL(TC_Status__c, &quot;New&quot;), ISPICKVAL(TC_Status__c, &quot;Active&quot;)), TODAY() - DATEVALUE(CreatedDate), null)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Days Open</label>
    <precision>18</precision>
    <scale>0</scale>
    <type>Number</type>
</CustomField>
