<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TC_Term_Months__c</fullName>
    <formula>(YEAR(TC_Expiration_Date__c) - YEAR(TC_Commencement_Date__c)) * 12 + MONTH(TC_Expiration_Date__c) - MONTH(TC_Commencement_Date__c) + IF(DAY(TC_Expiration_Date__c) &gt;= DAY(TC_Commencement_Date__c) - 1, 1, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Term (Months)</label>
    <precision>18</precision>
    <scale>0</scale>
    <type>Number</type>
</CustomField>
