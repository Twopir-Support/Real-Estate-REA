<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TC_Co_Broker_Requires_Party</fullName>
    <active>true</active>
    <description>Choose an Account or Contact for this commission.</description>
    <errorConditionFormula>AND(
    NOT($Setup.TC_Bypass_Settings__c.TC_Bypass_Validation_Rules__c),
    AND(OR($RecordType.DeveloperName = &quot;TC_Co_Broker&quot;, $RecordType.DeveloperName = &quot;TC_Analyst&quot;), ISBLANK(TC_Account__c), ISBLANK(TC_Contact__c), ISBLANK(TC_Broker__c))
)</errorConditionFormula>
    <errorDisplayField>TC_Contact__c</errorDisplayField>
    <errorMessage>Choose an Account or Contact for this commission.</errorMessage>
</ValidationRule>
